{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "final_space": true,
    "version": 4,
    "transient_prompt": {
        "foreground": "#7C6F64",
        "template": "\uf105 "
    },
    "blocks": [
        {
            "type": "prompt",
            "alignment": "left",
            "segments": [
                {
                    "type": "path",
                    "style": "plain",
                    "template": "{{ .Path }} ",
                    "foreground": "#80AA9E",
                    "options": {
                        "style": "folder"
                    }
                },
                {
                    "type": "jujutsu",
                    "style": "plain",
                    "foreground": "#D3869B",
                    "template": "{{ if (glob \".jj\") }}\uf1fa{{ .ChangeID }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }} {{ end }}"
                },
                {
                    "type": "git",
                    "alias": "GitMain",
                    "style": "plain",
                    "foreground": "#D3869B",
                    "template": "{{ if and (glob \".git\") (not (glob \".jj\")) }} {{ .HEAD }} {{ end }}",
                    "options": {
                        "branch_icon": "\ue725 ",
                        "cherry_pick_icon": "\ue29b ",
                        "commit_icon": "\uf417 ",
                        "fetch_status": true,
                        "fetch_upstream_icon": true,
                        "merge_icon": "\ue727 ",
                        "no_commits_icon": "\uf0c3 ",
                        "rebase_icon": "\ue728 ",
                        "revert_icon": "\uf0e2 ",
                        "tag_icon": "\uf412 "
                    }
                },
                {
                    "type": "text",
                    "style": "plain",
                    "foreground": "#F2594B",
                    "template": "{{ if gt .Code 0 }}{{ end }} "
                },
                {
                    "type": "executiontime",
                    "style": "plain",
                    "template": "{{ .FormattedMs }} ",
                    "foreground": "#E9B143",
                    "options": {
                        "threshold": 500,
                        "style": "austin",
                        "always_enabled": true
                    }
                },
                {
                    "type": "text",
                    "style": "plain",
                    "foreground": "#7C6F64",
                    "template": "\uf105"
                }
            ]
        }
    ]
}
