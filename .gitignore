**/.DS_Store

jj/dot-config/jj/conf.d
jj/dot-config/jj/repos
git/dot-config/.gitignore.global.local

# Fish config
# Ignore generated/plugin files by default
fish/dot-config/fish/completions/
fish/dot-config/fish/conf.d/
fish/dot-config/fish/functions/
fish/dot-config/fish/themes/
fish/dot-config/fish/fish_variables

# Allow hand-written config
!fish/dot-config/fish/config.fish
!fish/dot-config/fish/fish_plugins
!fish/dot-config/fish/functions/jp.fish
!fish/dot-config/fish/functions/jc.fish
!fish/dot-config/fish/functions/gwl.fish
!fish/dot-config/fish/functions/claude-local.fish
!fish/dot-config/fish/functions/claude-send.fish
!fish/dot-config/fish/functions/localpkg.fish

# Machine-only config, loaded by each tool's own include (see MIGRATION.md)
local.*
*.local
*.local.*

# nushell writes these next to its config (autoload/ is regenerated by env.nu)
nushell/dot-config/nushell/history.*
nushell/dot-config/nushell/plugin.msgpackz
nushell/dot-config/nushell/autoload/
